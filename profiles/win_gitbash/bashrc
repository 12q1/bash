# ==========================================
# 1. Shell-Init Cache
# ==========================================
# `starship init`, `zoxide init`, and `fzf --bash` each spawn a
# subprocess just to print a static shell script. Process spawn is
# slow on Windows/MSYS (~50-250ms each), which was pushing shell
# startup past half a second and swallowing the first keystroke if
# you typed before readline was ready. Cache each generated script
# to a file and just source it instead. Run `refreshinit` after
# upgrading starship/zoxide/fzf or editing starship.toml.
_init_cache="$HOME/.cache/shell-init"
mkdir -p "$_init_cache"

_cached_init() {
    local name="$1" file="$_init_cache/$1.sh"
    shift
    [ -f "$file" ] || "$@" > "$file"
    source "$file"
}

# ==========================================
# 2. Initialize Starship Prompt (First!)
# ==========================================
_cached_init starship starship init bash --print-full-init

# ==========================================
# 3. Global Variables & Editor
# ==========================================
export EDITOR=vim
export YAZI_CONFIG_HOME="$HOME/.config/yazi"

# ==========================================
# 4. History Settings
# ==========================================
export HISTSIZE=50000
export HISTFILESIZE=50000
export HISTCONTROL=ignoredups:erasedups
shopt -s histappend

# ==========================================
# 5. Load Aliases
# ==========================================
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# ==========================================
# 6. Initialize Zoxide & Fzf
# ==========================================
_cached_init zoxide zoxide init bash
_cached_init fzf fzf --bash

# Fix Zoxide's Windows Git Bash compiler bug (v0.10.0)
function __zoxide_pwd() {
    \command cygpath -w "$(\builtin pwd -L)"
}

# ==========================================
# 7. Git Completion (Last! fzf's completion setup
# overwrites git's own completion for the bare
# 'git' command otherwise)
# ==========================================
if [ -f /mingw64/share/git/completion/git-completion.bash ]; then
    source /mingw64/share/git/completion/git-completion.bash
    __git_complete gco _git_checkout
    __git_complete gb _git_branch
    __git_complete gp _git_push
    __git_complete gl _git_log
fi
