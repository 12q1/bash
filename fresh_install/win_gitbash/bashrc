# ==========================================
# 1. Initialize Starship Prompt (First!)
# ==========================================
eval "$(starship init bash)"

# ==========================================
# 2. Global Variables & Editor
# ==========================================
export EDITOR=vim
export YAZI_CONFIG_HOME="$HOME/.config/yazi"

# ==========================================
# 3. History Settings
# ==========================================
export HISTSIZE=50000
export HISTFILESIZE=50000
export HISTCONTROL=ignoredups:erasedups
shopt -s histappend

# ==========================================
# 4. Load Aliases
# ==========================================
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# ==========================================
# 5. Initialize Zoxide & Fzf
# ==========================================
eval "$(zoxide init bash)"
eval "$(fzf --bash)"

# Fix Zoxide's Windows Git Bash compiler bug (v0.10.0)
function __zoxide_pwd() {
    \command cygpath -w "$(\builtin pwd -L)"
}

# ==========================================
# 6. Git Completion (Last! fzf's completion setup
# overwrites git's own completion for the bare
# 'git' command otherwise)
# ==========================================
if [ -f /mingw64/share/git/completion/git-completion.bash ]; then
    source /mingw64/share/git/completion/git-completion.bash
    __git_complete gco _git_checkout
    __git_complete gb _git_branch
    __git_complete gp _git_push
    __git_complete gl _git_log
fi
