[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	autocrlf = true
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Monokai Extended
	side-by-side = false
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
	path = ~/.gitconfig_local
[push]
	autoSetupRemote = true
