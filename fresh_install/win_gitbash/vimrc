" ==============================================================================
" Custom .vimrc configuration
" Organized with clear comments for every setting.
" ==============================================================================

" ------------------------------------------------------------------------------
" 1. GUI Compatibility
" ------------------------------------------------------------------------------
" If Vim is run as 'evim' (Easy Vim, which acts like a standard GUI text editor),
" skip the rest of this configuration file to avoid overrides.
if v:progname =~? "evim"
  finish
endif

" ------------------------------------------------------------------------------
" 2. Base Defaults
" ------------------------------------------------------------------------------
" Load standard default settings provided by Vim (enables things like filetype
" detection, indentation, and basic key mappings).
source $VIMRUNTIME/defaults.vim

" ------------------------------------------------------------------------------
" 3. Backups, Swap Files, and Undo History
" ------------------------------------------------------------------------------
if has("vms")
  " OpenVMS has its own built-in file versioning system, so backups are disabled.
  set nobackup
else
  " Keep backup files so you can restore to a previous version if needed.
  set backup
  
  " Enable persistent undo (allows you to undo changes even after closing and reopening a file).
  if has('persistent_undo')
    set undofile
  endif

  " Centralize temporary files so they don't clutter up your project folders/Git repositories.
  " The '//' at the end tells Vim to use the full path of the file to create a unique name,
  " preventing filename collisions between files in different directories.
  set backupdir=~/.vim/backup//
  set directory=~/.vim/swap//
  set undodir=~/.vim/undo//

  " Automatically create these directories on your machine if they don't exist yet.
  if !isdirectory(expand('~/.vim/backup'))
    call mkdir(expand('~/.vim/backup'), 'p')
  endif
  if !isdirectory(expand('~/.vim/swap'))
    call mkdir(expand('~/.vim/swap'), 'p')
  endif
  if !isdirectory(expand('~/.vim/undo'))
    call mkdir(expand('~/.vim/undo'), 'p')
  endif
endif

" ------------------------------------------------------------------------------
" 4. Visual & Highlight Settings
" ------------------------------------------------------------------------------
" Switch on highlighting for the last used search pattern if the terminal supports color.
if &t_Co > 2 || has("gui_running")
  set hlsearch
endif

" Always display line numbers on the left.
set number

" ------------------------------------------------------------------------------
" 5. Filetype-Specific Rules
" ------------------------------------------------------------------------------
" Define a clean auto-command group for text files.
augroup vimrcEx
  au!
  " For generic plain text files, wrap text at 78 characters.
  autocmd FileType text setlocal textwidth=78
augroup END

" ------------------------------------------------------------------------------
" 6. Optional Packages
" ------------------------------------------------------------------------------
" Load 'matchit' package (makes the '%' key match opening/closing HTML/XML tags,
" if-else blocks, etc., in addition to simple parentheses).
if has('syntax') && has('eval')
  packadd! matchit
endif

" ------------------------------------------------------------------------------
" 7. Indentation & Spacing Settings
" ------------------------------------------------------------------------------
" Configured for standard 4-space indents (great for VS Code and ESLint compatibility).
set expandtab     " Use spaces instead of physical tab characters when pressing Tab
set tabstop=4     " The width of a tab character (measured in space characters)
set shiftwidth=4  " Number of spaces used for auto-indentation steps (e.g., using '<<' or '>>')
set softtabstop=4 " Number of spaces a Tab counts for while editing/deleting

" ------------------------------------------------------------------------------
" 8. Colorscheme & Transparency Adjustments
" ------------------------------------------------------------------------------
syntax on         " Enable syntax highlighting
colorscheme slate " Use the 'slate' color scheme

" Custom highlight overrides to keep comments readable and ensure the background is 
" fully transparent (ctermbg=NONE / guibg=NONE) so your terminal's background shines through.
highlight Comment ctermfg=7 guifg=#bcbcbc
highlight Normal ctermbg=NONE guibg=NONE
highlight NonText ctermbg=NONE guibg=NONE
highlight LineNr ctermbg=NONE guibg=NONE
highlight SignColumn ctermbg=NONE guibg=NONE
highlight EndOfBuffer ctermbg=NONE guibg=NONE
