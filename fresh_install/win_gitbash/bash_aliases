# ============================================
# ~/.bash_aliases
# Custom Bash Aliases for Navigation, Git,
# System Maintenance, and Web Dev Utilities
# Optimized for Windows / Git Bash Environment
# Reload with: source ~/.bash_aliases
# ============================================

# ==========================
# Gitbash Windows stuff
# ==========================
alias yazi='yazi.exe'
alias btop='btop4win.exe'


# ===========================
# ⚡️ General Quality-of-Life
# ===========================
alias c='clear'                                  # Clear screen
alias cls='clear'                                # Windows muscle memory
alias reload='exec "$SHELL"'                     # Restart shell
alias path='echo -e ${PATH//:/\\n}'              # Pretty print PATH
alias editbash='nano ~/.bash_aliases'            # Edit this file
alias reloadbash='source ~/.bash_aliases'        # Reload aliases
alias editrc='nano ~/.bashrc'                    # Edit .bashrc quickly


# ===========================
# 📁 Directory Navigation
# ===========================
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias winhome='cd /c/Users/$USER'        # Jump to Windows home (Git Bash /c/)
alias findme='explorer.exe .'                         # Open current dir in Explorer
alias mkcd='foo(){ mkdir -p "$1" && cd "$1"; }; foo'  # Create + enter directory


# ===========================
# 📜 File Listing (eza-powered)
# ===========================
alias ls='eza --icons=always --git'                      # Standard list with icons & git status
alias l='eza -F --icons=always'                          # Brief folder grid with classification marks
alias la='eza -a --icons=always --git'                   # Show all files (including hidden/dotfiles)
alias ll='eza -al --icons=always --git'                  # Detailed long list (size, permissions, dates)
alias lt='eza -T --level=2 --icons=always'               # Gorgeous 2-level directory tree view!
alias dudir='du -sh -- * | sort -h'                  # Sort dirs by disk usage (can be slow on large folders)
alias dirsize='du -sh * | sort -h'                   # Folder sizes
alias largest='du -ah . | sort -rh | head -20'       # Largest 20 files
alias recent='ls -lt | head -20'                     # Most recent files
alias tree1='tree -L 1'                              # 1-level tree view


# ===========================
# ⚙️ System & Utilities
# ===========================
alias reboot='shutdown /r /t 0'                      # Windows restart
alias shutdown='shutdown /s /t 0'                    # Windows shutdown
alias resbash='source ~/.bashrc'
alias wipeHistory='history -c && history -w'
alias dfh='df -h'                                    # Disk usage (human-readable)
alias ports='netstat -ano | grep LISTENING'          # Open ports (Windows native alternative)
alias ipinfo='ipconfig'                              # IP info (Windows native alternative)


# ===========================
# 🔍 Search Helpers
# ===========================
alias grep='grep --color=auto'                       # Highlight grep matches
alias histg='history | grep'                         # Search history quickly


# ===========================
# 🧰 Git Shortcuts
# ===========================
alias gs='git status -sb'                            # Compact git status
alias gb='git branch'
alias gco='git checkout'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'      # Pretty log graph
alias gac='git add . && git commit -m'               # Add all + commit
alias amend='git commit --amend --no-edit'           # Amend last commit
alias gundo='git reset --soft HEAD~1'                # Undo last commit
# Clean up merged branches (excluding active branch, master, main, and dev)
alias gitclean='git branch --merged | grep -E -v "(^\*|master|main|dev)" | xargs -r git branch -d'
# Force delete all branches (excluding active branch, master, main, and dev)
alias gitpurge='git branch | grep -E -v "(^\*|master|main|dev)" | xargs -r git branch -D'


# ===========================
# 🧠 DevOps / Remote Servers
# ===========================

# Todo: move these into ~/.ssh/config for cleaner usage.


# ===========================
# 🐳 Docker & Containers
# ===========================
alias d='docker'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dstop='docker stop $(docker ps -q)'
alias drm='docker rm $(docker ps -aq)'
alias dclean='docker system prune -af'
alias dexec='docker exec -it'
alias dlogs='docker logs --tail 100 -f'
alias compose='docker-compose'


# ===========================
# 🧩 Python / Node / Web Dev
# ===========================
alias py='python'
alias venv='python -m venv .venv && source .venv/Scripts/activate' # Windows-native virtualenv activation path
alias runserver='python manage.py runserver'
alias serve='python -m http.server 8000'
alias npmi='npm install'
alias npms='npm start'
alias npmt='npm test'
alias npmb='npm run build'


# ===========================
# 🗂️ Safety & Maintenance
# ===========================
alias rm='rm -i'                                     # Confirm before deleting
alias mv='mv -i'                                     # Confirm before overwriting
alias cp='cp -i'                                     # Confirm before overwriting
alias chmodx='chmod +x'                              # Make executable quickly


# ===========================
# 🔔 Notifications & Extras
# ===========================
alias weather='curl wttr.in'                         # Quick weather lookup
alias myip='curl ifconfig.me'                        # Show external IP
alias shrug='echo "¯\\_(ツ)_/¯"'                      # Emotional debugging


# ===========================
# 🧩 Meta Helpers
# ===========================
alias aliases='cat ~/.bash_aliases | grep -E "^alias" | column -t -s"="'  # List all aliases
alias al='alias | sort'                                                   # Show sorted aliases
